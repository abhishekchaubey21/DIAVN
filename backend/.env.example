# =============================================================================
# DIAVN Backend Environment Configuration
# All external APIs are OPTIONAL and must use free tiers or open-source tools.
# =============================================================================

# Server Settings
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api/v1

# Supabase / PostgreSQL Configuration (Free Tier)
# Required for persistent database storage and migrations in later phases
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres

# Gemini AI (Free Tier API Key - Direct FastAPI integration in Phase 2)
# Optional in Phase 1 (Foundation)
GEMINI_API_KEY=your-gemini-free-api-key
